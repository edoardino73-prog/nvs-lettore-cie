<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NVS Lettore CIE"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="1) Scrivi il CAN (6 cifre stampate sul fronte della carta).\n2) Appoggia la carta sul retro del tablet e tienila ferma.\n3) Quando compare il testo, apri NVS: Anagrafica - Importa da CIE."
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editCan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="CAN (6 cifre)"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/txtStato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pronto. Scrivi il CAN e appoggia la carta."
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtRisultato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#F1F5F9"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCopia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Copia i dati negli appunti"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCondividi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Condividi / salva come file"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
